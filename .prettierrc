{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cva"],
  "overrides": [
    {
      "files": ["*.css"],
      "options": {
        "printWidth": 120
      }
    }
  ]
}
