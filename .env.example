# ─────────────────────────────────────────────────────────────────────────────
# Kanpur Tiles — environment variables
# Copy to `.env.local` for local development and mirror in the Railway/Render
# dashboard. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase. https://supabase.com/dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Grants full access to your database and bypasses RLS.
# Never reference this from a client component or a Server Action that runs in
# the browser. It must not be prefixed with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp. Digits only, no `+`, no spaces. Country code first.
# Used to build `wa.me/<number>?text=…` deep links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical URL, no trailing slash. Used by sitemap.ts, robots.ts and OG tags.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable.
# Optional — only set if a GA property already exists.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Places API (New) key. Only needed for the Phase 2 reviews feed.
# Phase 1 ships with curated static reviews, so this may stay blank.
GOOGLE_PLACES_API_KEY=

# Set to "1" in CI to fail the build on any SAMPLE placeholder that leaked
# into the production source graph.
ENFORCE_NO_SAMPLE_DATA=
